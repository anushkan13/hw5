# Campus Customs — environment variables
#
# Copy this file to `.env` in this same folder and fill in your own key:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.

# Required. Portkey API key, used to reach the OpenAI model.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional. The chat model the agent team runs on. Defaults to gpt-6-luna when
# unset. This project is built around the cheap model on purpose — nothing in
# the team escalates to a larger one.
MODEL_NAME=gpt-6-luna

# Optional, frontend only. Where the React board looks for the backend.
# Defaults to http://localhost:8000 when unset.
VITE_API_BASE=http://localhost:8000
